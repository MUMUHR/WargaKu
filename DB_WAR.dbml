Table users {
  id int [pk, increment, note: 'Laravel id() = INT UNSIGNED']
  username varchar(50) [unique, not null, note: 'warga: NIK pendaftar pertama; admin: adminrt']
  password varchar(255) [not null]
  no_telp varchar(20)
  role enum('admin', 'warga') [not null, default: 'warga']
  created_at timestamp
  updated_at timestamp
}

Table keluarga {
  id int [pk, increment]
  no_kk varchar(16) [unique, not null, note: 'diisi warga saat pendaftaran']
  status_ekonomi enum('mampu', 'kurang_mampu') [not null]
  status_tinggal enum('tetap', 'kontrak', 'kos', 'menumpang') [not null, default: 'tetap']
  created_at timestamp
  updated_at timestamp

  indexes {
    no_kk
  }
}

Table warga {
  id int [pk, increment]
  user_id int [ref: > users.id, note: 'nullable, akun KK bersama, nullOnDelete']
  keluarga_id int [ref: > keluarga.id, not null, note: 'cascadeOnDelete']
  nik varchar(16) [unique, not null]
  nama varchar(100) [not null]
  tempat_lahir varchar(100)
  tanggal_lahir date
  jenis_kelamin enum('laki_laki', 'perempuan') [not null]
  agama enum('islam', 'katolik', 'protestan', 'buddha', 'hindu', 'konghucu')
  pendidikan_terakhir enum(
    'tidak_belum_sekolah',
    'belum_tamat_sd',
    'sd_sederajat',
    'smp_sederajat',
    'sma_sederajat',
    'd1_d2',
    'd3',
    'd4_s1',
    's2',
    's3'
  )
  pekerjaan varchar(100)
  alamat text
  status_hubungan enum(
    'kepala_keluarga',
    'suami',
    'istri',
    'anak',
    'menantu',
    'cucu',
    'orang_tua',
    'mertua',
    'famili_lain',
    'lainnya'
  ) [not null]
  status_warga enum('hidup', 'meninggal', 'pindah_rumah', 'pindah_kk') [not null, default: 'hidup']
  created_at timestamp
  updated_at timestamp

  indexes {
    keluarga_id
    status_warga
  }
}

Table riwayat_perubahan {
  id int [pk, increment]
  warga_id int [ref: > warga.id, note: 'nullable jika jenis_pengajuan = tambah_anggota, nullOnDelete']
  keluarga_id int [ref: > keluarga.id, not null, note: 'cascadeOnDelete']
  jenis_pengajuan enum('ubah_data', 'tambah_anggota') [not null]
  data_lama json [note: 'null jika tambah_anggota']
  data_baru json [not null, note: 'field yang diajukan']
  bukti_path varchar(255) [not null, note: 'disimpan di disk privat']
  status enum('menunggu', 'disetujui', 'ditolak', 'dibatalkan') [not null, default: 'menunggu']
  alasan text
  admin_id int [ref: > users.id, note: 'nullable, nullOnDelete']
  created_at timestamp
  updated_at timestamp
}

Table surat {
  id int [pk, increment]
  pemohon_id int [ref: > warga.id, not null, note: 'warga pemilik akun yang login']
  warga_tujuan_id int [ref: > warga.id, not null, note: 'dipilih via dropdown anggota KK']
  keperluan text [not null]
  nomor_surat varchar(50) [unique, note: 'diisi saat disetujui']
  status enum('menunggu', 'disetujui', 'ditolak', 'dibatalkan') [not null, default: 'menunggu']
  alasan text
  created_at timestamp
  updated_at timestamp
}

Table iuran {
  id int [pk, increment]
  keluarga_id int [ref: > keluarga.id, not null, note: 'cascadeOnDelete']
  nominal decimal(10,2) [not null, default: 50000.00]
  catatan text [note: 'nullable, rincian iuran']
  bulan tinyint [not null, note: '1-12']
  tahun smallint [not null]
  status enum('lunas', 'belum_lunas') [not null, default: 'belum_lunas']
  tanggal_bayar datetime [note: 'nullable, diisi saat lunas']
  created_at timestamp
  updated_at timestamp

  indexes {
    (keluarga_id, bulan, tahun) [unique, note: 'mencegah duplikasi baris iuran per keluarga']
  }
}

Table pengumuman {
  id int [pk, increment]
  judul varchar(150) [not null]
  isi text [not null]
  gambar varchar(255) [note: 'nullable, path file thumbnail']
  status_publikasi enum('draft', 'publish') [not null, default: 'draft']
  admin_id int [ref: > users.id, note: 'nullable, nullOnDelete']
  created_at timestamp
  updated_at timestamp
}
